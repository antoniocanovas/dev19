<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_crm_opportunity_rules" model="ir.ui.view">
        <field name="name">res.partner.form.crm.opportunity.rules</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="crm_new_suggestion_count" invisible="1"/>
                <button name="action_view_crm_suggestions" type="object"
                    class="oe_stat_button" icon="fa-lightbulb-o">
                    <field name="crm_new_suggestion_count" widget="statinfo" string="Sugerencias"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
