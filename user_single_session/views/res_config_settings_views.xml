<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_single_session" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.user.single.session</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="after">
                <block title="Sesión única" name="single_session_setting_container">
                    <setting id="user_single_session_enforce"
                             help="Si un usuario inicia sesión mientras ya tiene otra sesión activa en otro dispositivo, deberá cerrar el resto de sesiones antes de acceder al backend. Se puede exceptuar usuarios concretos desde su ficha.">
                        <field name="user_single_session_enforce"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
