<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_business_product_type_view_list_survey" model="ir.ui.view">
        <field name="name">crm.business.product.type.list.survey</field>
        <field name="model">crm.business.product.type</field>
        <field name="inherit_id" ref="crm_business_product.crm_business_product_type_view_list"/>
        <field name="arch" type="xml">
            <field name="attribute_ids" position="after">
                <field name="survey_ids" widget="many2many_tags"/>
            </field>
        </field>
    </record>

    <record id="crm_business_product_type_view_form_survey" model="ir.ui.view">
        <field name="name">crm.business.product.type.form.survey</field>
        <field name="model">crm.business.product.type</field>
        <field name="inherit_id" ref="crm_business_product.crm_business_product_type_view_form"/>
        <field name="arch" type="xml">
            <field name="attribute_ids" position="after">
                <field name="survey_ids" widget="many2many_tags"/>
            </field>
        </field>
    </record>

</odoo>
