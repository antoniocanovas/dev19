<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ai_domain_chat_wizard_view_form" model="ir.ui.view">
        <field name="name">mercas.mcp.domain.chat.wizard.form</field>
        <field name="model">mercas.mcp.domain.chat.wizard</field>
        <field name="arch" type="xml">
            <form string="Consultas IA">
                <sheet>
                    <div class="oe_title">
                        <h1>Consultas IA</h1>
                        <p class="text-muted">
                            Ventas, compras, facturación y stock. Cualquier otra pregunta
                            será rechazada. Los importes/cantidades vienen directamente
                            de Odoo — no los alucina la IA.
                        </p>
                    </div>
                    <field name="history_display" nolabel="1" widget="mercas_chat_history"/>
                    <group>
                        <field name="message" nolabel="1"
                               placeholder="Ej: ¿Cuánto ha comprado Cliente1 este mes? (Ctrl+Enter / Cmd+Enter para enviar)"
                               widget="mercas_chat_message"/>
                    </group>
                    <div class="mt-2">
                        <button name="action_send" type="object" string="Enviar"
                                class="btn-primary o_mercas_chat_send"/>
                        <button name="action_reset" type="object" string="Nueva conversación"
                                class="btn-secondary" confirm="Se archivará el historial actual. ¿Continuar?"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_domain_chat_wizard_action" model="ir.actions.act_window">
        <field name="name">Consultas IA</field>
        <field name="res_model">mercas.mcp.domain.chat.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="mcp_gateway_menu_domain_chat"
              name="Consultas IA"
              parent="odoo_mcp_manager.mcp_gateway_menu_root"
              action="ai_domain_chat_wizard_action"
              sequence="6"/>

</odoo>
