<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.muk_ai_ollama</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="muk_ai.view_res_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='muk_ai_extensions']" position="before">
                <block title="Ollama" name="muk_ai_ollama_settings">
                    <setting
                        id="muk_ai_ollama_base_url"
                        string="Base URL"
                        help="Ollama API endpoint. Change if Ollama runs on a remote host or non-default port."
                    >
                        <field name="ollama_base_url"/>
                        <button
                            name="%(muk_ai.action_muk_ai_provider)d"
                            type="action"
                            string="Manage AI Providers"
                            icon="oi-arrow-right"
                            class="btn-link mt-3"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
