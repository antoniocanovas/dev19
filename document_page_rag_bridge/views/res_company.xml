<odoo>
    <record id="view_company_form_rag_bridge" model="ir.ui.view">
        <field name="name">res.company.form.rag.bridge</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="RAG Bridge" name="rag_bridge">
                    <field name="rag_image_engine"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
