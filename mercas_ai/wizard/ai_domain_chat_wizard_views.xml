<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ai_domain_chat_wizard_view_form" model="ir.ui.view">
        <field name="name">mercas.mcp.domain.chat.wizard.form</field>
        <field name="model">mercas.mcp.domain.chat.wizard</field>
        <field name="arch" type="xml">
            <form string="Consultas IA">
                <div class="o_mercas_chat_container">
                    <div class="oe_title">
                        <h1>Consultas IA</h1>
                        <p class="text-muted">
                            [Debug] Consola de dominio original, previa a la fusión en
                            "Chat IA" — se mantiene solo para depuración/comparación,
                            misma lógica que Chat IA.
                        </p>
                    </div>
                    <field name="history_display" nolabel="1" widget="mercas_chat_history"/>
                    <div class="o_mercas_chat_row mt-2">
                        <field name="message" nolabel="1"
                               placeholder="Ej: ¿Cuánto ha comprado Cliente1 este mes? (Intro para enviar, Mayús+Intro para salto de línea)"
                               widget="mercas_chat_message"/>
                        <div class="o_mercas_chat_actions">
                            <button name="action_send" type="object" string="Enviar"
                                    class="btn-primary o_mercas_chat_send"/>
                            <button name="action_reset" type="object" string="Nueva conversación"
                                    class="btn-secondary" confirm="Se archivará el historial actual. ¿Continuar?"/>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <record id="ai_domain_chat_wizard_action" model="ir.actions.act_window">
        <field name="name">Consultas IA</field>
        <field name="res_model">mercas.mcp.domain.chat.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- Debug-only: su lógica se fusionó en "Chat IA" (ai_chat_wizard.py). Se
         conserva sin borrar para depuración/comparación, visible solo con el
         modo desarrollador activo. -->
    <menuitem id="mcp_gateway_menu_domain_chat"
              name="Consultas IA (debug)"
              parent="odoo_mcp_manager.mcp_gateway_menu_root"
              action="ai_domain_chat_wizard_action"
              groups="base.group_no_one"
              sequence="6"/>

</odoo>
