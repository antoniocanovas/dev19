<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Clasificación de clientes (crm.partner.profile.line) -->

    <record id="crm_partner_profile_line_view_list_report" model="ir.ui.view">
        <field name="name">crm.partner.profile.line.list.report</field>
        <field name="model">crm.partner.profile.line</field>
        <field name="arch" type="xml">
            <list string="Clasificación de clientes" create="false">
                <field name="partner_id"/>
                <field name="attribute_id"/>
                <field name="value_ids" widget="many2many_tags" context="{'show_attribute': False}"/>
            </list>
        </field>
    </record>

    <record id="crm_partner_profile_line_view_pivot" model="ir.ui.view">
        <field name="name">crm.partner.profile.line.pivot</field>
        <field name="model">crm.partner.profile.line</field>
        <field name="arch" type="xml">
            <pivot string="Clasificación de clientes">
                <field name="attribute_id" type="row"/>
                <field name="value_ids" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="crm_partner_profile_line_view_search_report" model="ir.ui.view">
        <field name="name">crm.partner.profile.line.search.report</field>
        <field name="model">crm.partner.profile.line</field>
        <field name="arch" type="xml">
            <search string="Clasificación de clientes">
                <field name="partner_id"/>
                <field name="attribute_id"/>
                <field name="value_ids"/>
                <group>
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Tipo" name="group_attribute" context="{'group_by': 'attribute_id'}"/>
                    <filter string="Valor" name="group_value" context="{'group_by': 'value_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="crm_partner_profile_line_action_report" model="ir.actions.act_window">
        <field name="name">Clasificación de clientes</field>
        <field name="res_model">crm.partner.profile.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="crm_partner_profile_line_view_search_report"/>
        <field name="context">{'search_default_group_attribute': 1}</field>
    </record>

    <menuitem id="crm_partner_profile_line_menu_report"
        name="Clasificación de clientes"
        parent="crm.crm_menu_report"
        action="crm_partner_profile_line_action_report"
        sequence="5"/>

    <!-- Productos y servicios actuales (crm.partner.current_product) -->

    <record id="crm_partner_current_product_view_list_report" model="ir.ui.view">
        <field name="name">crm.partner.current_product.list.report</field>
        <field name="model">crm.partner.current_product</field>
        <field name="arch" type="xml">
            <list string="Productos y servicios actuales" create="false">
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="state" widget="badge"
                    decoration-success="state == '1_ok'"
                    decoration-info="state == '2_to_evolve'"
                    decoration-warning="state == '3_to_change'"
                    decoration-muted="state == '4_stopped'"
                    decoration-danger="state == '5_obsolete'"/>
                <field name="provider" widget="badge"
                    decoration-success="provider == 'us'"
                    decoration-muted="provider == 'internal'"
                    decoration-info="provider == 'multiple'"
                    decoration-warning="provider == 'competitor'"/>
            </list>
        </field>
    </record>

    <record id="crm_partner_current_product_view_pivot" model="ir.ui.view">
        <field name="name">crm.partner.current_product.pivot</field>
        <field name="model">crm.partner.current_product</field>
        <field name="arch" type="xml">
            <pivot string="Productos y servicios actuales">
                <field name="product_tmpl_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="crm_partner_current_product_view_search_report" model="ir.ui.view">
        <field name="name">crm.partner.current_product.search.report</field>
        <field name="model">crm.partner.current_product</field>
        <field name="arch" type="xml">
            <search string="Productos y servicios actuales">
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <filter string="A evolucionar" name="to_evolve" domain="[('state', '=', '2_to_evolve')]"/>
                <filter string="A cambiar" name="to_change" domain="[('state', '=', '3_to_change')]"/>
                <filter string="Parados" name="stopped" domain="[('state', '=', '4_stopped')]"/>
                <filter string="Obsoletos" name="obsolete" domain="[('state', '=', '5_obsolete')]"/>
                <separator/>
                <filter string="En competencia" name="competitor" domain="[('provider', '=', 'competitor')]"/>
                <group>
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Producto/servicio" name="group_product" context="{'group_by': 'product_tmpl_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Proveedor" name="group_provider" context="{'group_by': 'provider'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="crm_partner_current_product_action_report" model="ir.actions.act_window">
        <field name="name">Productos y servicios actuales</field>
        <field name="res_model">crm.partner.current_product</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="crm_partner_current_product_view_search_report"/>
        <field name="context">{'search_default_group_product': 1}</field>
    </record>

    <menuitem id="crm_partner_current_product_menu_report"
        name="Productos y servicios actuales"
        parent="crm.crm_menu_report"
        action="crm_partner_current_product_action_report"
        sequence="6"/>

</odoo>
