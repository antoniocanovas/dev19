<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_partner_form_mercas" model="ir.ui.view">
        <field name="name">res.partner.form.mercas</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <group name="sale" position="inside">
                <field name="mercas_margin"/>
            </group>
            <div name="button_box" position="inside">
                <button
                    name="action_view_mercas_box_quants"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-cubes"
                    invisible="not mercas_box_qty"
                >
                    <field name="mercas_box_qty" widget="statinfo" string="Cajas"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
