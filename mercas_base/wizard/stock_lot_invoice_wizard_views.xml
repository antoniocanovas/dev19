<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_stock_lot_invoice_wizard_form" model="ir.ui.view">
        <field name="name">stock.lot.invoice.wizard.form</field>
        <field name="model">stock.lot.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Facturar lotes completados">
                <group>
                    <field name="partner_id"/>
                    <field name="date_to"/>
                    <field name="show_all"/>
                </group>
                <field name="currency_id" invisible="1"/>
                <field name="line_ids">
                    <list create="0" editable="bottom">
                        <field name="selected" readonly="not invoiceable" force_save="1" string=""/>
                        <field name="lot_id" readonly="1" force_save="1"/>
                        <field name="mercas_firm_negotiation" string="FF" widget="boolean_toggle" readonly="1" optional="show"/>
                        <field name="invoiceable" readonly="1" column_invisible="1"/>
                        <field name="ref" readonly="1" optional="hide"/>
                        <field name="create_date" readonly="1" string="Alta"/>
                        <field name="company_id" readonly="1" optional="hide" groups="base.group_multi_company"/>
                        <field name="partner_ids" readonly="1" optional="hide" widget="many2many_tags"/>
                        <field name="product_qty" readonly="1" optional="hide"/>
                        <field name="completed" readonly="1" optional="show"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="purchase_kg" readonly="1" optional="show" sum="Kg comprados"/>
                        <field name="received_kg" readonly="1" optional="hide" sum="Kg recibidos"/>
                        <field name="net_invoiced_kg" readonly="1" optional="show" sum="Kg facturados"/>
                        <field name="sale_kg" readonly="1" optional="hide" sum="Kg vendidos"/>
                        <field name="scrap_kg" readonly="1" optional="hide" sum="Kg desechados"/>
                        <field name="sale_amount" readonly="1" optional="hide" sum="Importe vendido"/>
                        <field name="mercas_margin" readonly="mercas_firm_negotiation"/>
                        <field name="supplier_price_kg" readonly="1" invisible="mercas_firm_negotiation"/>
                        <field name="supplier_amount" readonly="1" invisible="mercas_firm_negotiation"/>
                        <field name="net_invoiced_amount" readonly="1" optional="show" invisible="mercas_firm_negotiation" string="Facturado" sum="Facturado"/>
                        <field name="amount_to_invoice" readonly="1" string="A facturar" sum="A facturar"/>
                    </list>
                </field>
                <group class="oe_subtotal_footer">
                    <field name="amount_total" widget="monetary"/>
                </group>
                <footer>
                    <button name="action_liquidar" string="Liquidar"
                            type="object" class="btn-primary"/>
                    <button name="action_invoice_advance" string="Facturar adelanto"
                            type="object" class="btn-secondary"/>
                    <button name="action_invoice_firm" string="Factura firme"
                            type="object" class="btn-secondary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_lot_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Facturar lotes</field>
        <field name="res_model">stock.lot.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_lot"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
